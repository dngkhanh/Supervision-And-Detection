# =============================================================
# SECRET TEMPLATE — Infrastructure/k8s/secret.yaml.example
#
# HƯỚNG DẪN SỬ DỤNG:
#   1. Copy file này thành secret.yaml:
#      cp secret.yaml.example secret.yaml
#
#   2. Encode giá trị thật bằng base64:
#      echo -n "your-actual-value" | base64
#
#   3. Thay thế các placeholder bên dưới bằng giá trị base64 thật
#
#   4. Apply lên cluster:
#      kubectl apply -f Infrastructure/k8s/secret.yaml
# =============================================================

# Secret cho API Gateway
apiVersion: v1
kind: Secret
metadata:
  name: api-gateway-secret
  namespace: supervision-dev
  labels:
    app: api-gateway
    environment: local
type: Opaque
data:
  # api-gateway chỉ proxy request, không tự verify token → không cần JWT_SECRET

---
# Secret cho User Service
# user-service ký token bằng ACCESS_TOKEN_SECRET + REFRESH_TOKEN_SECRET
# và upload CV lên Cloudinary
apiVersion: v1
kind: Secret
metadata:
  name: user-service-secret
  namespace: supervision-dev
  labels:
    app: user-service
    environment: local
type: Opaque
data:
  # echo -n "mongodb+srv://user:password@cluster.mongodb.net/userdb" | base64
  MONGO_URI: REPLACE_WITH_BASE64_ENCODED_VALUE
  # echo -n "your-access-token-secret" | base64
  ACCESS_TOKEN_SECRET: REPLACE_WITH_BASE64_ENCODED_VALUE
  # echo -n "your-refresh-token-secret" | base64
  REFRESH_TOKEN_SECRET: REPLACE_WITH_BASE64_ENCODED_VALUE
  # echo -n "your-cloudinary-cloud-name" | base64
  CLOUDINARY_CLOUD_NAME: REPLACE_WITH_BASE64_ENCODED_VALUE
  # echo -n "your-cloudinary-api-key" | base64
  CLOUDINARY_API_KEY: REPLACE_WITH_BASE64_ENCODED_VALUE
  # echo -n "your-cloudinary-api-secret" | base64
  CLOUDINARY_API_SECRET: REPLACE_WITH_BASE64_ENCODED_VALUE

---
# Secret cho Job Service
# job-service verify Access Token + publish search events lên RabbitMQ cloud
apiVersion: v1
kind: Secret
metadata:
  name: job-service-secret
  namespace: supervision-dev
  labels:
    app: job-service
    environment: local
type: Opaque
data:
  # echo -n "mongodb+srv://user:password@cluster.mongodb.net/jobdb" | base64
  MONGO_URI: REPLACE_WITH_BASE64_ENCODED_VALUE
  # echo -n "your-access-token-secret" | base64  (phải GIỐNG user-service)
  ACCESS_TOKEN_SECRET: REPLACE_WITH_BASE64_ENCODED_VALUE
  # echo -n "amqps://user:pass@host.cloudamqp.com/vhost" | base64
  RABBITMQ_URI: REPLACE_WITH_BASE64_ENCODED_VALUE

---
# Secret cho Application Service
# application-service verify Access Token từ request của user
apiVersion: v1
kind: Secret
metadata:
  name: application-service-secret
  namespace: supervision-dev
  labels:
    app: application-service
    environment: local
type: Opaque
data:
  # echo -n "mongodb+srv://user:password@cluster.mongodb.net/applicationdb" | base64
  MONGO_URI: REPLACE_WITH_BASE64_ENCODED_VALUE
  # echo -n "your-access-token-secret" | base64  (phải GIỐNG user-service)
  ACCESS_TOKEN_SECRET: REPLACE_WITH_BASE64_ENCODED_VALUE

---
# Secret cho Recommend Service
# recommend-service verify Access Token + consume queue recommend_queue từ RabbitMQ cloud
apiVersion: v1
kind: Secret
metadata:
  name: recommend-service-secret
  namespace: supervision-dev
  labels:
    app: recommend-service
    environment: local
type: Opaque
data:
  # echo -n "mongodb+srv://user:password@cluster.mongodb.net/recommenddb" | base64
  MONGO_URI: REPLACE_WITH_BASE64_ENCODED_VALUE
  # echo -n "your-access-token-secret" | base64  (phải GIỐNG user-service)
  ACCESS_TOKEN_SECRET: REPLACE_WITH_BASE64_ENCODED_VALUE
  # echo -n "amqps://user:pass@host.cloudamqp.com/vhost" | base64
  RABBITMQ_URI: REPLACE_WITH_BASE64_ENCODED_VALUE
