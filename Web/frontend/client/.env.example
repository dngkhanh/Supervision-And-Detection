# ============================================================
# frontend (Vite) — .env.example
# Copy thành .env và điền giá trị thực
#   cp .env.example .env
#
# Lưu ý: Vite chỉ expose biến có prefix VITE_ ra browser.
#         Không đặt secret trong file này.
# ============================================================

# URL của API Gateway — browser gọi trực tiếp
# Khi chạy Docker Compose local: http://localhost:3000
# Khi deploy production: https://api.yourdomain.com
VITE_API_URL=http://localhost:3000
