# ============================================================
# recommend-service — .env.example
# Copy thành .env và điền giá trị thực
#   cp .env.example .env
# ============================================================

# Port lắng nghe
PORT=3004

# Node environment
NODE_ENV=development

# MongoDB Atlas — connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/supervision-recommend?retryWrites=true&w=majority

# JWT — Access Token (phải giống với user-service để verify token)
ACCESS_TOKEN_SECRET=your_access_token_secret_here

# RabbitMQ — Message Broker (Worker subscribe queue recommend_queue)
# Khi chạy Docker Compose: amqp://guest:guest@rabbitmq:5672
# Khi chạy standalone:     amqp://guest:guest@localhost:5672
RABBITMQ_URI=amqp://guest:guest@rabbitmq:5672
