# ============================================================
# application-service — .env.example
# Copy thành .env và điền giá trị thực
#   cp .env.example .env
# ============================================================

# Port lắng nghe
PORT=3003

# Node environment
NODE_ENV=development

# MongoDB Atlas — connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/supervision-applications?retryWrites=true&w=majority

# JWT — Access Token (phải giống với user-service để verify token)
ACCESS_TOKEN_SECRET=your_access_token_secret_here
